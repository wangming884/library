# ================================================
# 生产环境配置文件 (.env.prod)
# 部署前请复制此文件为 .env.prod，并填写您的云端实际参数
# ================================================

# 1. 您的 Docker Hub 镜像地址与标签
DOCKER_IMAGE=your-dockerhub-username/library-management:latest

# 2. 外部映射访问端口 (http://云服务器公网IP:8080/library)
APP_PORT=8080

# 3. 云服务器已有 MySQL 数据库配置
# - 若 MySQL 是直接以系统服务安装在当前云服务器上：
#   DB_HOST 填写 host.docker.internal 或 宿主机内网IP (如 172.17.0.1)
# - 若 MySQL 是独立云数据库 (如阿里云 RDS / 腾讯云 CDB) 或远程服务器：
#   DB_HOST 填写对应的内网/公网 IP 或域名
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=library_db
DB_USERNAME=root
DB_PASSWORD=your_actual_mysql_password

# 4. 生产环境 JVM 堆内存 (根据云服务器规格调整，例如 2G 内存机器建议 -Xmx1024m)
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
