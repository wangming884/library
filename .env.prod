# ================================================
# 生产环境配置文件 (.env.prod)
# ================================================

# 1. 您的 Docker Hub 镜像地址与标签
DOCKER_IMAGE=leemingze/library-management:v1.0.0

# 2. 外部访问端口 (http://云服务器公网IP:7623/library)
APP_PORT=7623

# 3. 云服务器已有 MySQL 数据库配置
# - 若 MySQL 是直接安装在当前云服务器上：保持 127.0.0.1 即可！
# - 若 MySQL 是云数据库 RDS：填入 RDS 的内网地址或公网域名
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=library_db
DB_USERNAME=root
DB_PASSWORD=请替换为您的实际数据库密码

# 4. 生产环境 JVM 堆内存与垃圾回收优化
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
