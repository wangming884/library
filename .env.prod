# ================================================
# 生产环境配置文件 (.env.prod)
# ================================================

# 1. 您的 Docker Hub 镜像地址与标签
DOCKER_IMAGE=leemingze/library-management:v1.0.0

# 2. 外部映射访问端口 (http://云服务器公网IP:8080/library)
APP_PORT=8080

# 3. 云服务器已有 MySQL 数据库配置
# - 若 MySQL 是直接运行在云服务器宿主机上：
#   DB_HOST 填写 host.docker.internal 或 宿主机内网IP (如 172.17.0.1)
# - 若 MySQL 是独立云数据库 (如阿里云 RDS / 腾讯云 CDB) 或远程数据库：
#   DB_HOST 填写对应的内网/公网 IP 或域名
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=library_db
DB_USERNAME=root
DB_PASSWORD=请在此填入您的云端MySQL真实密码

# 4. 生产环境 JVM 堆内存与垃圾回收参数
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
